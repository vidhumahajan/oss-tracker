# Copy this file to .env and fill in the values. Never commit .env.

# From MongoDB Atlas: Connect > Drivers > copy the connection string.
# Put a database name before the "?", for example ...mongodb.net/oss-tracker?...
MONGODB_URI=

# From your GitHub OAuth app (GitHub > Settings > Developer settings > OAuth Apps).
# For your laptop, the app's callback URL must be:
#   http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Two secrets. Generate each one with this command and paste the output:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs login cookies. Changing it logs everyone out.
# TOKEN_ENCRYPTION_KEY encrypts stored GitHub tokens. If you change or lose
# it, every member has to log in again before their PRs can sync.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# GitHub usernames that are always admins, separated by commas.
# Put your own username here, then log in.
ADMIN_LOGINS=

# The address people open in the browser. Leave as is on your laptop.
APP_URL=http://localhost:5173

PORT=4000

# Optional: AI summaries of merged pull requests.
# Get a free key at https://console.groq.com/keys (sign up, then Create API Key).
# Leave it empty to switch the feature off: the "Write summary" button
# disappears, and summaries already saved can still be read.
AI_API_KEY=
# The chat completions address. Leave empty for Groq:
# https://api.groq.com/openai/v1/chat/completions
# Any OpenAI-compatible service works here, with its own key and model.
AI_API_URL=
# Which model writes the summaries. Leave empty for openai/gpt-oss-120b.
SUMMARY_MODEL=

# Optional: "Add it for me" on the GitHub profile badge panel.
# This must be a SECOND OAuth app, separate from the login one above,
# because it asks for permission to write to public repos.
# Its Authorization callback URL must be:
#   https://YOUR-SITE/api/badge/callback
# Leave both empty to switch it off: members copy the badge line by hand.
# It also stays off while APP_URL is a localhost address, because a badge
# pointing at localhost would show as broken on GitHub.
BADGE_GITHUB_CLIENT_ID=
BADGE_GITHUB_CLIENT_SECRET=

# Optional: session emails (new requests, confirmations, reminders).
# There are two ways to send. The README's "Sending email" section has the
# steps for both.
#   1. Brevo's HTTP API: set BREVO_API_KEY and MAIL_FROM. Use this when your
#      host blocks SMTP ports, which many free hosting plans do. When the key
#      is set, every email goes through Brevo and the SMTP settings are ignored.
#   2. SMTP: leave BREVO_API_KEY empty and set SMTP_HOST, SMTP_USER and SMTP_PASS.
# With neither, email is off. The rest of the site works the same, and the
# server logs one line about it.

# From Brevo: Settings > SMTP & API > API keys > Generate a new API key.
# It starts with xkeysib-. MAIL_FROM below must be a sender you verified in
# Brevo under Settings > Senders, Domains, IPs > Senders.
BREVO_API_KEY=

# The mail server, for example smtp.gmail.com
SMTP_HOST=
# 587 for most servers, including Gmail. Use 465 if yours says "SSL".
SMTP_PORT=587
# The account that sends, for example the-site-account@gmail.com
SMTP_USER=
# Its password. For Gmail, an app password (16 letters, no spaces),
# never your normal password.
SMTP_PASS=
# The "From" line people see, for example OSS Tracker <the-site-account@gmail.com>
# Used by both Brevo and SMTP. With Brevo it is required and must be a
# verified sender. With Gmail SMTP it must be the account's own address, and
# leaving it empty uses SMTP_USER.
MAIL_FROM=
# Where new session requests and the admins' reminders go. Your own address.
ADMIN_EMAIL=
# The time zone for dates and times in emails. Leave empty for Asia/Kolkata.
# Any name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=
